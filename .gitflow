# Gitflow Configuration
# Branch naming conventions and workflow

[gitflow "branch"]
  master = master
  develop = develop
  feature = feature/
  bugfix = bugfix/
  release = release/
  hotfix = hotfix/
  support = support/

[gitflow "prefix"]
  feature = feature/
  bugfix = bugfix/
  release = release/
  hotfix = hotfix/
  support = support/
