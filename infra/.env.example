# Copie este arquivo para .env e preencha os valores reais.
# NUNCA comite o arquivo .env no repositório.

# Google OAuth 2.0
# Configure em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# JWT — mínimo 32 caracteres, gerado aleatoriamente
# Sugestão: openssl rand -base64 32
JWT_KEY=change-this-to-a-random-string-with-at-least-32-chars

# Primeiro Chefe Escoteiro — o primeiro login com este e-mail recebe papel ChefesEscoteiro
INITIAL_ADMIN_EMAIL=admin@escoteiros.org.br

# URL base da API (usada para gerar links de convite de Patrulha)
APP_BASE_URL=http://localhost:5001
